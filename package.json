{
	"name": "meowcorp-assistant",
	"version": "1.0.0",
	"author": "Meowcorp",
	"license": "BSD-3-Clause",
	"private": true,
	"scripts": {
		"activity:dev": "bun run --env-file=.env --filter activity dev",
		"bot:dev": "bun run --env-file=.env --filter bot dev",
		"bot:cmd": "bun run --env-file=.env --filter bot cmd",
		"dev": "bun run --env-file=.env --parallel --workspaces dev"
	},
	"workspaces": [
		"activity",
		"bot"
	],
	"dependencies": {
		"@types/bun": "^1.3.10",
		"@types/node": "^25.5.0"
	}
}
